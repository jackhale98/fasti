{
	"name": "fasti",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "GPL-2.0-or-later",
	"description": "A web front end for the Remind reminder language. Static, offline, and your files stay yours.",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"licenses": "node scripts/check-licenses.mjs",
		"engine:build": "engine/build.sh",
		"spdx": "node scripts/check-spdx.mjs",
		"lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop",
		"lighthouse:mobile": "LH_PRESET=mobile lhci autorun",
		"lighthouse:desktop": "LH_PRESET=desktop lhci autorun"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/young-serif": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"idb": "^8.0.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fake-indexeddb": "^6.2.6",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
