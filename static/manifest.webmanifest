{
	"id": "./",
	"name": "Fasti",
	"short_name": "Fasti",
	"description": "A web front end for Remind, the plain-text reminder language. Works offline; your .rem files stay yours.",
	"lang": "en",
	"dir": "ltr",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"background_color": "#f2f4f1",
	"theme_color": "#f2f4f1",
	"categories": ["productivity", "utilities"],
	"icons": [
		{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{
			"src": "icon-maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"shortcuts": [
		{ "name": "Today", "url": "./" },
		{ "name": "Month", "url": "./month" },
		{ "name": "Script", "url": "./script" }
	]
}
